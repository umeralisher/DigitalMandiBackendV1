PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/digital_mandi
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
# Comma separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173
# If true, new farmer accounts stay "pending" until an admin approves them
REQUIRE_FARMER_APPROVAL=true
# Used by `npm run seed`
ADMIN_EMAIL=admin@digitalmandi.pk
ADMIN_PASSWORD=Admin@12345
